# Copy this file to `.env`, fill in your key, then run `source .env`.

export OPENAI_API_KEY="your-openai-api-key"
export CLI_AGENT_ALLOWED_COMMANDS="ralio"

# Optional: skip Ralio agent discovery when you already know the target agent.
# export RALIO_AGENT_ID="your-ralio-agent-id"

# Optional: print model, CLI, and turn timings to stderr.
# export AGENT_TIMING="1"
